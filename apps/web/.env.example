# ─── Neon Postgres ────────────────────────────────────────────────────────────
# Restricted runtime role (NOBYPASSRLS): used by normal application requests.
DATABASE_URL=postgresql://app_user:password@host.neon.tech/dbname?sslmode=require

# Privileged owner/BYPASSRLS role: used only for migrations and /api/setup-db.
# Never expose this value to the browser or use it for normal application queries.
ADMIN_DATABASE_URL=postgresql://owner:password@host.neon.tech/dbname?sslmode=require

# ─── Firebase (Auth only) ─────────────────────────────────────────────────────
# From: Firebase Console → Project Settings → Your Apps → Web App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# From: Firebase Console → Project Settings → Service accounts → Generate new private key
# Paste the entire JSON content as a single string (no newlines)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── App ──────────────────────────────────────────────────────────────────────
# Super-admin email: can activate/suspend agencies via /api/admin/action
SUPER_ADMIN_EMAIL=

# 32-byte minimum secret used to encrypt stored provider credentials
ENCRYPTION_KEY=

# Shared secret used by Vercel Cron when calling /api/jobs/* routes
CRON_SECRET=

# Production: https://your-domain.com  |  Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Distributed rate limiting (required in production) ───────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Error monitoring (recommended in production) ─────────────────────────────
# Both values normally use the same Sentry DSN; the public value is used by the browser.
# The Vercel Sentry integration provisions NEXT_PUBLIC_SENTRY_DSN. SENTRY_DSN
# remains an optional server-only override for self-managed Sentry setups.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ─── Optional ─────────────────────────────────────────────────────────────────
# Set to "true" to show the Firestore→Postgres migration tool in the accounting page
NEXT_PUBLIC_SHOW_MIGRATION_TOOL=false

# Set to "true" to connect Firebase Auth to local emulator (port 9099)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
